{
  "name": "freecodego",
  "version": "0.1.7-alpha.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiangSu-ce/dsh-plugin-freecodego.git",
    "directory": "packages/freecodego/bundle-latest"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "freecodego"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-alpha.2"
  },
  "type": "module",
  "main": "./dist/bootstrap.js",
  "exports": {
    ".": "./dist/bootstrap.js",
    "./client": "./dist/client.cjs",
    "./harness-plugin": "./dist/harness-plugin.js",
    "./session-events": "./dist/session-events.js",
    "./agent-team": "./dist/agent-team.js",
    "./tool-agent-team": "./dist/tool-agent-team.js",
    "./schedule": "./dist/schedule.js",
    "./auto-review": "./dist/auto-review.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/freecodego.patch.yml",
        "./presets/augmentcode.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "freecodego": {
    "harnessBaseline": "0.1.7-alpha.2"
  },
  "license": "AGPL-3.0-only",
  "files": [
    "dist/bootstrap.js",
    "dist/client.cjs",
    "dist/harness-plugin.js",
    "dist/session-events.js",
    "dist/agent-team.js",
    "dist/tool-agent-team.js",
    "dist/schedule.js",
    "dist/auto-review.js",
    "dist/workers/*.js",
    "dist/assets/**/*",
    "cordis.patch.yml",
    "presets/*.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../../scripts/build-freecodego-bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.246",
    "eventsource-parser": "^3.1.0",
    "js-yaml": "^4.2.0",
    "tar": "7.5.2",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-freecodego-agent-engine-router": "workspace:^",
    "@deepseek-ai/dsh-freecodego-harness-plugin": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.7-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": ">=0.1.7-alpha.2",
    "@deepseek-ai/cosmokit": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent-instructions": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent-loop": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent-preset": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-alpha.2",
