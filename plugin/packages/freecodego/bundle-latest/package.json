{
  "name": "freecodego",
  "version": "0.2.0-rc.2",
  "description": "FreeCodeGo distribution bundle for the DeepSeek Harness: one composition, its host plugin, and its client factory",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiangSu-ce/dsh-plugin-freecodego.git",
    "directory": "packages/freecodego/bundle-latest"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "freecodego"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "type": "module",
  "main": "./dist/bootstrap.js",
  "exports": {
    ".": "./dist/bootstrap.js",
    "./client": "./dist/client.cjs",
    "./harness-plugin": "./dist/harness-plugin.js",
    "./session-events": "./dist/session-events.js",
    "./subagent-codex": "./dist/subagent-codex.js",
    "./subagent-claude-code": "./dist/subagent-claude-code.js",
    "./tool-session-query": "./dist/tool-session-query.js",
    "./auto-review": "./dist/auto-review.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/freecodego.patch.yml",
        "./presets/augmentcode.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "freecodego": {
    "harnessBaseline": "0.2.0-rc.2"
  },
  "license": "AGPL-3.0-only",
  "files": [
    "dist/bootstrap.js",
    "dist/client.cjs",
    "dist/harness-plugin.js",
    "dist/session-events.js",
    "dist/subagent-codex.js",
    "dist/subagent-claude-code.js",
    "dist/tool-session-query.js",
    "dist/auto-review.js",
    "dist/workers/*.js",
    "dist/assets/**/*",
    "cordis.patch.yml",
    "presets/*.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../../scripts/build-freecodego-bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.246",
    "@openai/codex": "0.153.4",
    "eventsource-parser": "^3.1.0",
    "js-yaml": "^4.2.0",
    "tar": "7.5.2",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-freecodego-agent-engine-router": "workspace:^",
    "@deepseek-ai/dsh-freecodego-harness-plugin": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis":    ">=0.2.0-rc.2",
    "@deepseek-ai/cordis-plugin-loader":    ">=0.2.0-rc.2",
    "@deepseek-ai/cosmokit":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-agent":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-instructions":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-atomic-write":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-brand":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-command-compact":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-command-goal":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-http-proxy":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-deepseek":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-lsp":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-lsp-stdio":    ">=0.2.0-rc.2",    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-output-retention": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-persona":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-plan-mode":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-plugin-manager":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-scope":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-settings":    ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem":    ">=0.2.0-rc.2",
