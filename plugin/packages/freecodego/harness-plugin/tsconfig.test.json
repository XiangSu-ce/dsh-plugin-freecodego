{
  // The package project (`tsconfig.json`) includes only `src`, so nothing under
  // `tests/` was ever type-checked — the same gap `harness-ui/tsconfig.test.json`
  // closes for its own suite. Type-only: this never writes into `lib/`.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src", "tests"],
  "references": [
    // The two entries at the end are the only ones the package project does not
    // carry, and they are not interchangeable with the rest: the suite appends
    // those events through the typed `Session.append`, so their `SessionEventMap`
    // merges have to be in the program, while the plugin's `src` reads them as raw
    // data on purpose and must not depend on them.
    // Derived by `scripts/gen-freecodego-test-tsconfig.ts`; edit that, not this list.
    { "path": "../../../vendor/cordis" },
    { "path": "../../../vendor/loader" },
    { "path": "../../../vendor/schemastery" },
