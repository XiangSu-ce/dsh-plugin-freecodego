{
  "name": "@deepseek-ai/dsh-freecodego-harness-plugin",
  "description": "FreeCodeGo engine inventory and lifecycle plugin for DeepSeek Harness",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiangSu-ce/dsh-plugin-freecodego.git",
    "directory": "packages/freecodego/harness-plugin"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "THIRD_PARTY_NOTICES.md",
    "assets/engineering/**/*",
    "assets/presets/**/*.yml",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "dsh": {
    "bootstrap": {
      "module": "./lib/index.js",
      "export": "bootstrapFreeCodeGoHarness"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-freecodego-api": "workspace:^",
    "@deepseek-ai/dsh-freecodego-native-runtime-host": "workspace:^",
    "@deepseek-ai/dsh-freecodego-native-runtime-protocol": "workspace:^",
    "@deepseek-ai/dsh-freecodego-root-agent": "workspace:^",
    "@deepseek-ai/dsh-freecodego-runtime-claude": "workspace:^",
    "@deepseek-ai/dsh-freecodego-runtime-codex": "workspace:^",
    "@deepseek-ai/dsh-fs-local": "workspace:^",
    "@deepseek-ai/dsh-lsp": "workspace:^",
    "@deepseek-ai/dsh-lsp-stdio": "workspace:^",
    "@deepseek-ai/dsh-sandbox-policy": "workspace:^",
    "@deepseek-ai/dsh-token-meter": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "eventsource-parser": "^3.1.0",
    "js-yaml": "^4.2.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/dsh-attachment": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-llm-deepseek": "workspace:^",
    "@deepseek-ai/dsh-mcp-client": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "@deepseek-ai/dsh-user-approval": "workspace:^",
    "@deepseek-ai/dsh-user-questions": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:^",
    "@deepseek-ai/dsh-subprocess-local": "workspace:^",
    "@deepseek-ai/dsh-tool-lsp": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^"
  }
}
